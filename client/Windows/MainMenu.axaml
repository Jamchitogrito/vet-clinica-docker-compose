<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="client.Windows.MainMenu"
        xmlns:dto="using:client.dto"
        Title="MainMenu" Opened="OnOpened">
  <ScrollViewer>
    <StackPanel>

      <Border BorderBrush="White" BorderThickness="2" Margin="5">
        <StackPanel>
          <TextBlock Text="Владельцы"/>
          <WrapPanel Margin="0,5">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="ID:" VerticalAlignment="Center"/>
              <TextBox x:Name="ownerId" Width="60"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="ФИО:" VerticalAlignment="Center"/>
              <TextBox x:Name="ownerFio" Width="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="Телефон:" VerticalAlignment="Center"/>
              <TextBox x:Name="ownerTelefon" Width="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Адрес:" VerticalAlignment="Center"/>
              <TextBox x:Name="ownerAdres" Width="200"/>
            </StackPanel>
          </WrapPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="Добавить"  Click="OwnerAdd_Click"    Margin="0,0,5,0"/>
            <Button Content="Удалить"   Click="OwnerDelete_Click" Margin="0,0,5,0"/>
            <Button Content="Изменить"  Click="OwnerUpdate_Click"/>
          </StackPanel>
          <ListBox x:Name="displayOwners" Height="200">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:OwnerDto">
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border BorderBrush="White" BorderThickness="2" Margin="5">
        <StackPanel>
          <TextBlock Text="Питомцы"/>
          <WrapPanel Margin="0,5">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="ID:" VerticalAlignment="Center"/>
              <TextBox x:Name="petId" Width="60"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="Кличка:" VerticalAlignment="Center"/>
              <TextBox x:Name="petKlichka" Width="120"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="Вид:" VerticalAlignment="Center"/>
              <TextBox x:Name="petVid" Width="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="Порода:" VerticalAlignment="Center"/>
              <TextBox x:Name="petPoroda" Width="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="Возраст:" VerticalAlignment="Center"/>
              <TextBox x:Name="petVozrast" Width="50"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="ID владельца:" VerticalAlignment="Center"/>
              <TextBox x:Name="petOwnerId" Width="60"/>
            </StackPanel>
          </WrapPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="Добавить"  Click="PetAdd_Click"    Margin="0,0,5,0"/>
            <Button Content="Удалить"   Click="PetDelete_Click" Margin="0,0,5,0"/>
            <Button Content="Изменить"  Click="PetUpdate_Click"/>
          </StackPanel>
          <ListBox x:Name="displayPets" Height="200">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:PetDto">
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border BorderBrush="White" BorderThickness="2" Margin="5">
        <StackPanel>
          <TextBlock Text="Записи"/>
          <WrapPanel Margin="0,5">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="ID:" VerticalAlignment="Center"/>
              <TextBox x:Name="diagnozId" Width="60"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="Название:" VerticalAlignment="Center"/>
              <TextBox x:Name="diagnozName" Width="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="Стадия:" VerticalAlignment="Center"/>
              <TextBox x:Name="diagnozStadia" Width="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="ID врача:" VerticalAlignment="Center"/>
              <TextBox x:Name="diagnozVrachId" Width="60"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <TextBlock Text="ID услуги:" VerticalAlignment="Center"/>
              <TextBox x:Name="diagnozUslugaId" Width="60"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="ID питомца:" VerticalAlignment="Center"/>
              <TextBox x:Name="diagnozPetId" Width="60"/>
            </StackPanel>
          </WrapPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="Добавить"  Click="DiagnozAdd_Click"    Margin="0,0,5,0"/>
            <Button Content="Удалить"   Click="DiagnozDelete_Click" Margin="0,0,5,0"/>
            <Button Content="Изменить"  Click="DiagnozUpdate_Click"/>
          </StackPanel>
          <ListBox x:Name="displayZapisi" Height="200">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:DiagnozDto">
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>